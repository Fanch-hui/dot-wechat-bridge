# Sites runtime: DB is provided by the manifest D1 binding.
# Configure new values through Sites Secret management; never commit actual secrets.
BRIDGE_TOKEN=
# Exactly 32 random bytes, encoded as standard base64; retain across deployments.
DATA_KEY_B64=

# Sites runtime settings, milliseconds unless stated otherwise.
SESSION_LEASE_MS=90000
SESSION_IDLE_MS=120000
SESSION_MAX_MS=3600000
READ_WAIT_MS=20000
WAKE_TIMEOUT_MS=60000
MAX_WAKE_ATTEMPTS=3
JOB_LEASE_MS=30000
GATEWAY_LEASE_MS=90000
MAX_DELIVERY_ATTEMPTS=3
SUBSCRIPTION_TTL_MS=86400000
SECRET_ROTATION_MS=60000
VERIFY_WAIT_MS=20000

# External gateway only; see deployment/gateway.config.example.json.
# Use the HTTPS origin returned by your own private Sites deployment.
BRIDGE_URL=
# Private Sites service access; distinct from BRIDGE_TOKEN and MCP user identity.
SITES_ACCESS_TOKEN=
GATEWAY_RUNTIME_DIR=.runtime
# Optional Tencent route tag.
# ILINK_ROUTE_TAG=
# ILINK_CLIENT_VERSION=2.4.9
